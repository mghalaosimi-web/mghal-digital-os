# Copy to .env.local. Never commit real credentials.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
OWNER_API_TOKEN="replace-with-a-long-random-secret"
APP_URL="http://localhost:3000"

# Optional private Neon Object Storage settings (server-side only)
AWS_ENDPOINT_URL_S3=
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
STORAGE_BUCKET=

# Optional integrations (server-side only)
# REDIS_URL=
# AI_PROVIDER=

# Optional: any OpenAI-compatible provider (server-side only)
# For a provider with a free quota, set its own key, model and HTTPS base URL.
# Local Ollama can use http://127.0.0.1:11434/v1 only in local development.
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1

# Backward-compatible OpenAI settings (used when AI_* values are not set)
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional in local development; required in production for login throttling
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
